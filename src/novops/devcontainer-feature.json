{
    "name": "Novops",
    "id": "novops",
    "version": "1.0.0",
    "description": "Novops, the universal secret and configuration manager for development, applications and CI.",
    "documentationURL": "https://github.com/PierreBeucher/novops",
    "keywords": [
        "teller",
        "payments",
        "cli",
        "finance",
        "banking",
        "developer"
    ],
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ],
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "v0.19.0"
            ],
            "default": "latest",
            "description": "The version of Novops to install."
        }
    }
}